#!/bin/bash

# womarchy-provision-user: per-user setup for whyprland (Hyprland on WSL).
#
#   womarchy-provision-user [--force]
#
# Installs the user templates from /usr/lib/womarchy/user into ~/.config:
#   hypr/hyprland.lua    the default Hyprland config (terminal, launcher, bar, keys)
#   hypr/monitors.lua    monitors from Windows (womarchy-session's generated rules)
#   hypr/womarchy.lua    WSL adjustments (keyboard layout from Windows, keys Windows reserves)
#   uwsm/env.d/10-womarchy  session environment (audio through PipeWire)
# A file the user already has is never replaced, except womarchy.lua (womarchy-managed).
# Idempotent. Marker: ~/.local/state/womarchy/provisioned

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: womarchy-provision-user [--force]

Per-user setup for whyprland, run as the user: creates the default Hyprland
config in ~/.config/hypr (only files that are missing; womarchy.lua is always
refreshed) and the uwsm session environment.
--force  run again although already done
USAGE
}

force=0
while (($#)); do
  case "$1" in
    --force) force=1; shift ;;
    --overlay-only) shift ;;   # accepted for compatibility; there is no other step any more
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if (( EUID == 0 )); then
  echo "Error: run womarchy-provision-user as the user being configured, not as root." >&2
  exit 1
fi

WOMARCHY_LIB="${WOMARCHY_LIB:-/usr/lib/womarchy}"
state="$HOME/.local/state/womarchy"
mkdir -p "$state"

if [[ -f $state/provisioned ]] && (( ! force )); then
  echo "womarchy user setup already complete (rerun with --force to refresh)."
  exit 0
fi

log() { printf '\e[32m==>\e[0m %s\n' "$*"; }

src="$WOMARCHY_LIB/user"
cfg="$HOME/.config"

# install_missing <template> <target>: never touches a file the user already has.
install_missing() {
  if [[ -e $2 ]]; then
    log "keeping your ${2/#$HOME/\~}"
  else
    install -D -m 0644 "$1" "$2"
    log "created ${2/#$HOME/\~}"
  fi
}

install_missing "$src/hypr/hyprland.lua" "$cfg/hypr/hyprland.lua"
install_missing "$src/hypr/monitors.lua" "$cfg/hypr/monitors.lua"
install -D -m 0644 "$src/hypr/womarchy.lua" "$cfg/hypr/womarchy.lua"
install_missing "$src/uwsm/env.d/10-womarchy" "$cfg/uwsm/env.d/10-womarchy"

if ! grep -qs 'require("womarchy")' "$cfg/hypr/hyprland.lua"; then
  printf '\e[33mwarning:\e[0m %s\n' "your ~/.config/hypr/hyprland.lua does not load womarchy.lua; add require(\"womarchy\") at its end for the Windows keyboard layout" >&2
fi

date -Is >"$state/provisioned"
log "womarchy user setup complete."
