#!/bin/bash

# womarchy-apply-system: apply whyprland's WSL system settings (idempotent).
#
# Runs the womarchy WSL leaves from /usr/lib/womarchy/wsl/ in order. Run by the
# image build (in the chroot) and after every update (womarchy-update), so
# package updates cannot undo them.
#
# Settings come from /etc/womarchy/config (WOMARCHY_DOCKER, WOMARCHY_REPO_URL:
# the hosted [womarchy] repo, default the GitHub `packages` release). A value
# given in the environment overrides the file and is saved to it, so later
# runs (whose sudo resets the environment) keep honouring it.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: womarchy-apply-system [--reassert]   apply the WSL leaves (run by womarchy-update)
       womarchy-apply-system --list         (print the plan, run nothing)
--install-user, --defer-provisioning, --first-install and --upgrade are accepted
for compatibility and change nothing: every mode applies the same leaves.

Environment / /etc/womarchy/config:
  WOMARCHY_DOCKER=1|0     enable docker.socket (0: Docker Desktop's WSL integration)
  WOMARCHY_REPO_URL=URL   the hosted [womarchy] repo (https://... or file:///...; a mirror or fork)
USAGE
}

list_only=0

while (($#)); do
  case "$1" in
    --install-user) shift; (($#)) && shift ;;
    --defer-provisioning|--first-install|--upgrade|--reassert) shift ;;
    --list) list_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

export WOMARCHY_LIB="${WOMARCHY_LIB:-/usr/lib/womarchy}"
LOG_FILE=/var/log/womarchy-apply-system.log

# --- settings: environment > /etc/womarchy/config > default ---------------------------
CONFIG=/etc/womarchy/config
declare -A DEFAULTS=([WOMARCHY_DOCKER]=1
                     [WOMARCHY_REPO_URL]=https://github.com/corexo/whyprland/releases/download/packages)
valid_setting() { # KEY VALUE
  case $1 in
    WOMARCHY_DOCKER) [[ $2 == [01] ]] ;;
    WOMARCHY_REPO_URL) [[ $2 =~ ^(https://[A-Za-z0-9.-]+|file://)/[A-Za-z0-9._~/%+-]*$ ]] ;;
    *) return 1 ;;
  esac
}
config_value() { # last valid KEY=VALUE line of the file (invalid ones are ignored)
  [[ -f $CONFIG ]] || return 0
  local v
  v=$(sed -n "s/^$1=//p" "$CONFIG" | tail -n1)
  v=${v%"${v##*[![:space:]]}"}
  if [[ -n $v ]] && ! valid_setting "$1" "$v"; then
    echo "warning: ignoring invalid $1='$v' in $CONFIG" >&2
    return 0
  fi
  printf '%s' "$v"
}
save_config() { # KEY VALUE (VALUE already validated; no sed: URLs contain / and &)
  install -d -m 0755 "${CONFIG%/*}"
  [[ -f $CONFIG ]] || install -m 0644 /dev/null "$CONFIG"
  local tmp
  tmp=$(mktemp "$CONFIG.XXXXXX")
  awk -v k="$1" -v v="$2" 'index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next } { print }
    END { if (!done) print k "=" v }' "$CONFIG" >"$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$CONFIG"
}
for key in "${!DEFAULTS[@]}"; do
  value=${!key:-}
  if [[ -n $value ]]; then
    valid_setting "$key" "$value" || { echo "Error: invalid $key='$value'" >&2; exit 1; }
    if (( EUID == 0 && ! list_only )) && [[ $(config_value "$key") != "$value" ]]; then save_config "$key" "$value"; fi
  else
    value=$(config_value "$key")
    value=${value:-${DEFAULTS[$key]}}
  fi
  export "$key=$value"
done

# WSL leaves, in order (pacman.sh first: later leaves may need the repos).
WSL_LEAVES=(binfmt.sh pacman.sh enable-services.sh gpu.sh audio.sh keyboard-locale.sh shm-mount.sh
            wslg-apps.sh)

if (( list_only )); then
  for leaf in "${WSL_LEAVES[@]}"; do echo "run   wsl/$leaf"; done
  exit 0
fi

if (( EUID != 0 )); then
  echo "Error: womarchy-apply-system must run as root" >&2
  exit 1
fi

# Leaves log here, not to the terminal; a failing leaf is reported and the rest still run.
touch "$LOG_FILE" && chmod 0640 "$LOG_FILE"
echo "=== $(date -Is) womarchy-apply-system" >>"$LOG_FILE"
failed=()
for leaf in "${WSL_LEAVES[@]}"; do
  if ! bash "$WOMARCHY_LIB/wsl/$leaf" >>"$LOG_FILE" 2>&1; then
    failed+=("wsl/$leaf")
    echo "womarchy-apply-system: wsl/$leaf failed" >>"$LOG_FILE"
  fi
done

if ((${#failed[@]})); then
  echo "womarchy-apply-system: failed leaves: ${failed[*]} (see $LOG_FILE)" >&2
  exit 1
fi
